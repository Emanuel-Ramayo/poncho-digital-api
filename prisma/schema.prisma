generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPostulacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Artesano {
  id           Int    @id @default(autoincrement())
  nombre       String
  especialidad String
  provincia    String
  localidad    String

  productos     Producto[]
  postulaciones Postulacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Decimal

  categoria_id Int
  artesano_id  Int

  categoria Categoria @relation(fields: [categoria_id], references: [id])
  artesano  Artesano  @relation(fields: [artesano_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id     Int    @id @default(autoincrement())
  nombre String

  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pabellon {
  id     Int    @id @default(autoincrement())
  nombre String

  sectores Sector[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sector {
  id     Int    @id @default(autoincrement())
  nombre String

  pabellon_id Int
  pabellon    Pabellon @relation(fields: [pabellon_id], references: [id])

  stands Stand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stand {
  id         Int     @id @default(autoincrement())
  numero     Int
  disponible Boolean @default(true)

  sector_id Int
  sector    Sector @relation(fields: [sector_id], references: [id])

  postulaciones Postulacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Postulacion {
  id     Int               @id @default(autoincrement())
  estado EstadoPostulacion @default(PENDIENTE)

  artesano_id Int
  artesano    Artesano @relation(fields: [artesano_id], references: [id])

  stand_id Int?
  stand    Stand? @relation(fields: [stand_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
