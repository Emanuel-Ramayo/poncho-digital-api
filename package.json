{
  "name": "poncho-digital-api",
  "version": "1.0.0",
  "description": "Trabajo práctico de Laboratorio de Desarrollo Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "docs": "node generar-docs.js",
    "db:test:preparar": "node --env-file=.env.test src/scripts/prepararBdPrueba.js",
    "test:preparar": "node --env-file=.env.test src/scripts/prepararBdPrueba.js",
    "test:schemas": "node --test tests/artesanos-schema.test.js tests/productos-schema.test.js tests/stands-schema.test.js",
    "test:integracion": "node --env-file=.env.test --import ./tests/configuracion.js --test --test-concurrency=1 tests/productos-integracion.test.js tests/integration/postulaciones.test.js tests/integration/usuarios.test.js",
    "test:optimizacion": "node src/scripts/medirOptimizacion.js",
    "test": "node --env-file=.env.test --import ./tests/configuracion.js --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emanuel-Ramayo/poncho-digital-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Emanuel-Ramayo/poncho-digital-api/issues"
  },
  "homepage": "https://github.com/Emanuel-Ramayo/poncho-digital-api#readme",
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "swagger-autogen": "^2.23.7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.4.3"
  }
}
