# .env.test.example
# Copiar este archivo como .env.test (NO se sube al repositorio).
# La BD de pruebas debe ser exclusiva: su nombre tiene que terminar en "_test".
# Sus tablas se vacían antes de cada caso de prueba.
#
# 1) Crear la base en PostgreSQL:  CREATE DATABASE poncho_digital_test;
# 2) Copiar este archivo:         copy .env.test.example .env.test   (Windows)
# 3) Completar TU_PASSWORD con la clave real de PostgreSQL.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/poncho_digital_test?schema=public"
DATABASE_URL_TEST="postgresql://postgres:TU_PASSWORD@localhost:5432/poncho_digital_test?schema=public"
NODE_ENV=test
JWT_SECRET="secreto-exclusivo-de-pruebas"
