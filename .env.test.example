# .env.test.example
# Copiar este archivo como .env.test (NO se sube al repositorio).
# La BD de pruebas debe ser exclusiva: su nombre tiene que contener "test".
# Sus tablas se vacian en cada ejecucion de los tests.
#
# 1) Crear la base en PostgreSQL:  createdb mydb_test
# 2) Copiar este archivo:         copy .env.test.example .env.test   (Windows)
# 3) Completar TU_PASSWORD con la clave real de PostgreSQL.
DATABASE_URL_TEST="postgresql://postgres:TU_PASSWORD@localhost:5432/mydb_test?schema=public"
JWT_SECRET="clave-secreta-solo-para-tests"
